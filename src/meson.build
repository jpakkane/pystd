stdlib = static_library('pystd',
  'pystd_common.cpp',
  'pystd2025/common.cpp',
  'pystd2025/regex.cpp',
  'pystd2025/filesystem.cpp',
  'pystd2025/tables.cpp',
  'pystd2025/threading.cpp',
  'pystd2026.cpp',
  'pystd2026_argparse.cpp',
  'pystd2026_regex.cpp',
  'pystd2026_pathlib.cpp',
  'pystd2026_shutil.cpp',
  'pystd2026_tables.cpp',
  'pystd2026_tempfile.cpp',
  'pystd2026_threading.cpp',
  include_directories: '../include',
  dependencies: pcre_dep)

stdlib_dep = declare_dependency(include_directories: '../include',
  link_with: stdlib)
